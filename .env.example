# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://trainer:trainer@localhost:5434/trainer
ALLOW_DEV_AUTH=true
DEV_USER_ID=00000000-0000-4000-8000-000000000001
JOB_SECRET=local-job-secret-change-me
CORS_ORIGINS=*

# Optional — without this, the API uses a deterministic offline LLM fallback.
GEMINI_API_KEY=

